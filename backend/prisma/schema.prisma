generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Sport {
  VOLEI
  BEACH_TENNIS
  FUTEVOLEI
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  DONE
}

enum OrderStatus {
  OPEN
  PAID
  CANCELLED
}

model Category {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  products  Product[]

  // Unicidade case-insensitive: índice único em lower(name) criado via SQL na migration
  // category_table (Prisma não modela índices de expressão).
}

model Court {
  id           String    @id @default(cuid())
  name         String
  sport        Sport
  pricePerHour Decimal   @db.Decimal(10, 2)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  bookings     Booking[]
}

model Booking {
  id            String        @id @default(cuid())
  courtId       String
  court         Court         @relation(fields: [courtId], references: [id])
  customerName  String
  customerPhone String
  startsAt      DateTime
  endsAt        DateTime
  status        BookingStatus @default(PENDING)
  price         Decimal       @db.Decimal(10, 2)
  createdAt     DateTime      @default(now())
  orders        Order[]

  @@index([courtId, startsAt])
  @@index([startsAt])
}

model Product {
  id         String          @id @default(cuid())
  name       String
  // price = costPrice * (1 + profitMargin/100), calculado no backend (ROUND_HALF_UP)
  price      Decimal         @db.Decimal(10, 2)
  costPrice  Decimal         @db.Decimal(10, 2)
  // margem em %, ex. 35.50
  profitMargin  Decimal      @db.Decimal(6, 2)
  stockQuantity Int
  categoryId String
  category   Category        @relation(fields: [categoryId], references: [id])
  active     Boolean         @default(true)
  createdAt  DateTime        @default(now())
  orderItems OrderItem[]

  // Unicidade case-insensitive entre itens ativos: índice único parcial em lower(name)
  // WHERE active = true, criado via SQL na migration category_table (Prisma não modela).
}

model Order {
  id           String      @id @default(cuid())
  bookingId    String?
  booking      Booking?    @relation(fields: [bookingId], references: [id])
  customerName String?
  status       OrderStatus @default(OPEN)
  total        Decimal     @db.Decimal(10, 2)
  createdAt    DateTime    @default(now())
  items        OrderItem[]

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  subtotal    Decimal @db.Decimal(10, 2)
}
